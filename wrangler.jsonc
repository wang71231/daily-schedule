{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-schedule",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "build": {
    "command": "node cloudflare/build.mjs",
    "watch_dir": ["index.html", "training.html", "university.html", "users.html", "state.js", "storage.js", "glass.css", "server/server-mode.js", "cloudflare/worker.mjs"]
  },
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none"},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "daily-schedule",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }]
}
